#!/usr/bin/env bash
# redirection
# Start with install nginx script
apt-get update
apt-get -y install nginx
echo "Holberton School is cool" > /var/www/html/index.html
sudo service nginx restart

#redirection
if ! grep -q "redirect_me" /etc/nginx/sites-available/default; then
	sed -i "s|server_name_;|server_name_;\n\tlocation /redirect_me {\n\treturn 301 https: //www.youtube.com/:\n\t}|" /etc/nginx/sites-available/default
fi
sudo service nginx restart

