#!/usr/bin/env bash
#not found page 404
# redirection
# Start with install nginx script
apt-get update
apt-get -y install nginx
echo "Holberton School is cool" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/404.html
#redirection
if ! grep -q "redirect_me" /etc/nginx/sites-available/default; then
        sed -i 's|server_name _;|server_name _;\n\tlocation /redirect_me {\n\treturn 301 https://www.youtube.com/;\n\t}|' /etc/nginx/sites-available/default

fi
#error page 404
if ! grep -q "error_page 404" /etc/nginx/sites-available/default; then
	sed -i "s|server_name _;|server_name _;\n\terror_page 404 /404.html;|" /etc/nginx/sites-available/default
fi

#custom header
if ! grep -q "X-Served-By" /etc/nginx/sites-available/default; then
	sed -i 's|server_name _;|server_name _;\n\tadd_header X-Served-By $hostname;|' /etc/nginx/sites-available/default
fi

sudo service nginx restart
